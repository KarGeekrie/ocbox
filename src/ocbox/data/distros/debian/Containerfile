FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl python3 \
    && rm -rf /var/lib/apt/lists/*

# uv and the OpenCode installer are both piped into `bash`, not `sh`: their
# scripts assume bash (e.g. OpenCode's does `set -euo pipefail` on line 2),
# which dash - Debian/Ubuntu's /bin/sh - rejects outright and fails the build.
RUN curl -LsSf https://astral.sh/uv/install.sh | bash -s -- --no-modify-path \
    && mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

# OpenCode agent CLI.
# NOTE: install method below is the officially documented install script as of
# this writing. Pin/verify against the exact version you want before relying
# on this in production - see the project plan's open question #3.
RUN curl -fsSL https://opencode.ai/install | bash \
    && mv "$HOME"/.opencode/bin/opencode /usr/local/bin/opencode

RUN mkdir -p /usr/local/lib/ocbox
COPY relay.py /usr/local/lib/ocbox/relay.py
COPY entrypoint.sh /usr/local/lib/ocbox/entrypoint.sh
RUN chmod +x /usr/local/lib/ocbox/entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/lib/ocbox/entrypoint.sh"]
