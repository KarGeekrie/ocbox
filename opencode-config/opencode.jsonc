{
  // ocbox mounts this file into every sandbox as OpenCode's *global* config,
  // and (in --no-sandbox mode) symlinks it straight into OpenCode's real
  // global config directory.
  //
  // provider.local.options.baseURL behaves differently depending on mode:
  //   - web/--tui (sandboxed): ocbox always overrides it to point at the
  //     relay reaching your LLM - whatever you put here is ignored there.
  //   - --no-sandbox: nothing overrides it. OpenCode uses this value as-is,
  //     so it must be your LLM server's real, directly-reachable address.
  // Fill in <IP>:<PORT> below for --no-sandbox to work; it's unused (and
  // safely ignored) in the sandboxed modes.
  //
  // Copy this to ~/.config/ocbox/opencode.jsonc and edit that instead if you
  // don't want it tracked in the repo; ocbox uses that copy when it exists,
  // this file otherwise. Point --opencode-config at another file to override
  // per invocation.
  //
  // NOTE: several keys below (lsp, compaction, attachment, disabled_providers,
  // instructions) are unverified against OpenCode's published schema in this
  // repo - check `opencode debug config` after your first real run to
  // confirm they survived (OpenCode drops keys it doesn't recognise
  // silently, without an error - see AGENTS.md's "Verification history").
  // "instructions" in particular is a guess at the mechanism, not just the
  // content - see opencode-config/instructions/README.md.

  "$schema": "https://opencode.ai/config.json",
  "instructions": ["instructions/*.md"],
  "lsp": true,
  // Disable session sharing
  "share": "disabled",
  // Disable OpenTelemetry telemetry
  "experimental": {
    "openTelemetry": false
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ai-lpec (local)",
      "options": {
        "baseURL": "http://<IP>:<PORT>/v1"
      },
      "models": {
        "Qwen3.8-27B-smart": {
          "name": "Qwen3.8-27B-smart",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        // NOTE: this model's key says "medium" but its "name" says
        // "smart-think" - double check which one was intended.
        "Qwen3.8-27B-medium": {
          "name": "Qwen3.8-27B-smart-think",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "smart-glm": {
          "name": "Glm5.3",
          "limit": {
            "context": 200000,
            "output": 81920
          }
        },
        "Qwen3.6-35B-fast": {
          "name": "Qwen3.6-35B-fast",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 81920
          }
        },
        "Qwen3.6-35B-fast-think": {
          "name": "Qwen3.6-35B-fast-think",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 81920
          }
        }
      }
    }
  },
  "small_model": "local/Qwen3.6-35B-fast",
  "disabled_providers": [
    "openai", "anthropic", "google", "azure", "bedrock",
    "cohere", "fireworks", "groq", "mistral", "perplexity",
    "together", "xai", "deepseek", "huggingface", "opencode"
  ],
  "permission": {
    "external_directory": {
      "*": "deny",
      "~/.config/opencode/skills/code-review/*": "allow",
      "~/.config/opencode/skills/sota-review/*": "allow"
    },
    "doom_loop": "deny"

    // Lecture seule dans le working directory
    //"read": "allow",
    // Interdire toute modification de fichiers
    //"edit": "deny",
    // Autoriser uniquement les commandes git
    //"bash": {
    //  "*": "deny",
    //  "git *": "allow"
    //},
    // Autoriser la recherche dans le code (utile pour la lecture)
    //"grep": "allow",
    // Autoriser le glob pour lister les fichiers
    //"glob": "allow",
    // Interdire l'accès aux répertoires externes
    // Interdire la navigation web
    // "webfetch": "deny",
    // Interdire la recherche web
    // "websearch": "deny"
    // Interdire les questions utilisateur (optionnel)
    //"question": "deny"
  }
}
