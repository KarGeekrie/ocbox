{
  // TEAM CONFIGURATION - pre-configured; editing it is possible but not
  // recommended.
  //
  // This repository is a preconfigured setup for our team, not a general-
  // purpose package: this file already declares the team's provider, models,
  // permissions and defaults. It is the only OpenCode file in your scope, and
  // ocbox hands it to OpenCode in every mode. A change made for one person
  // makes their OpenCode behave differently from everyone else's; a change
  // everyone needs belongs in a commit here.
  //
  // How ocbox uses it: mounted into every sandbox as OpenCode's *global*
  // config, and in --no-sandbox mode placed in the config directory ocbox
  // hands OpenCode through OPENCODE_CONFIG_DIR.
  //
  // provider.local.options.baseURL is where the LLM server is, and it is read
  // in every mode: inside a sandbox it tells ocbox's relay what to dial (OpenCode
  // is pointed at the relay instead); with --no-sandbox OpenCode connects to it
  // directly. It must be plain http for the sandbox relay.
  //
  // Verified against opencode 1.18.29: every key below survives
  // `opencode debug config`. OpenCode drops keys it doesn't recognise
  // silently, so check any key added the same way.
  //
  // Standing instructions do NOT belong here - OpenCode's `instructions` key
  // is parsed but never resolved. Team rules go in opencode-config/AGENTS.md.

  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  // Disable session sharing
  "share": "disabled",
  // Disable OpenTelemetry telemetry
  "experimental": {
    "openTelemetry": false
  },
  // NOTE: "reserved" is INERT with the models declared below, and raising it
  // changes nothing. Checked against opencode's session/overflow.ts:
  //
  //   reserved = cfg.compaction.reserved ?? min(20000, maxOutputTokens(model))
  //   usable   = model.limit.input ? model.limit.input - reserved
  //                                : context - maxOutputTokens(model)
  //   auto-compaction fires when the session's token count >= usable
  //
  // "reserved" is only read on the first branch, which needs the model to
  // declare limit.input. Ours declare context + output only (limit.input is
  // optional in the schema and is not filled in for a custom provider), so the
  // second branch applies and the threshold is context - min(output, 32000):
  // 200000 - 32000 = 168000 tokens for every model below.
  //
  // To actually control it, declare "input" in a model's "limit" - then
  // reserved applies and should be at least opencode's own default of 20000,
  // since the compaction pass itself has to fit in what's left.
  "compaction": {
    "auto": true,
    // Old tool outputs are kept rather than pruned: a review that read twenty
    // files should still be able to quote them. Flip to true if sessions hit
    // the threshold above too fast.
    "prune": false,
    "reserved": 10000
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ai-lpec (local)",
      "options": {
        // Example: a local Ollama. Replace with the team's LLM server - see the
        // README's TODO.
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      // On "limit": opencode clamps a model's output to OUTPUT_TOKEN_MAX
      // (32000, unless OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX says otherwise),
      // so declaring 131072 below does not buy a longer answer - and since the
      // auto-compaction threshold is context - min(output, 32000), every model
      // here compacts at 168000 tokens. Add "input" to a "limit" block if you
      // want compaction.reserved to have any effect (see the note above it).
      "models": {
        "Qwen3.8-27B-smart": {
          "name": "Qwen3.8-27B-smart",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        // NOTE: this model's key says "medium" but its "name" says
        // "smart-think" - double check which one was intended.
        "Qwen3.8-27B-medium": {
          "name": "Qwen3.8-27B-smart-think",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "smart-glm": {
          "name": "Glm5.3",
          "limit": {
            "context": 200000,
            "output": 81920
          }
        },
        "Qwen3.6-35B-fast": {
          "name": "Qwen3.6-35B-fast",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 81920
          }
        },
        "Qwen3.6-35B-fast-think": {
          "name": "Qwen3.6-35B-fast-think",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 81920
          }
        }
      }
    }
  },
  "small_model": "local/Qwen3.6-35B-fast",
  "disabled_providers": [
    "openai", "anthropic", "google", "azure", "bedrock",
    "cohere", "fireworks", "groq", "mistral", "perplexity",
    "together", "xai", "deepseek", "huggingface", "opencode"
  ],
  // permission.bash/read/edit below are a mechanical backstop for the rules in
  // AGENTS.md and environments/*.md: those explain intent to the model, this
  // enforces it regardless of whether the model read, understood, or drifted
  // from them. Written once for every mode - see the comments on each block
  // for why a rule that's redundant in the sandbox (no sudo, no network, an
  // ephemeral filesystem) is still worth keeping there: it's inert, not wrong,
  // and it's the only thing standing between the model and the real host in
  // --no-sandbox.
  //
  // PATTERN MATCHING, as implemented in opencode 1.18.30 (read in its bundled
  // code, not guessed; tests/test_opencode_permissions.py replays it):
  //   - A pattern becomes a regex anchored at both ends where * -> .* and
  //     ? -> . , with the dotAll flag. * CROSSES "/" freely: "<dir>/*" also
  //     covers "<dir>/sub/file.md", and ** is no more recursive than *.
  //     ("ls *" and friends get one extra rule: a trailing " *" is optional,
  //     so "ls *" matches a bare "ls" too.)
  //   - The LAST matching rule wins, in the order rules are written:
  //     Permission.evaluate is findLast over OpenCode's own defaults, then
  //     this file, then agent-level rules. Nothing sorts by pattern length -
  //     Wildcard.all() does, but permissions don't go through it. So a
  //     general rule goes first and its exceptions after it, and REORDERING
  //     A BLOCK CHANGES WHAT IT MEANS.
  //   - read and edit are asked with the path RELATIVE to the project's
  //     worktree ("src/app.py", "../.ssh/id_rsa"), so a "~/..." or absolute
  //     pattern can never match there. external_directory is asked with the
  //     absolute parent directory plus "/*", links not resolved, and that is
  //     where anything outside the project is decided.
  "permission": {
    // external_directory stays deny-by-default on purpose: in --no-sandbox
    // it's what stands between the model and the rest of the host filesystem,
    // so keep it strict rather than "ask". Exceptions come after "*" (last
    // match wins): each --mount directory gets one, generated per run by
    // _generate_opencode_config() in sandbox.py, and the entries below cover
    // skills and OpenCode's own plans.
    "external_directory": {
      "*": "deny",
      // Skills' own files (SKILL.md, references/, agents/) - every skill at
      // once, since * crosses "/". OpenCode does add allow rules for the
      // skills it loads, but among its defaults, where the "*" above
      // overrides them.
      // Sandboxed modes: skills/ is bind-mounted, read-only, at OpenCode's
      // global skills path.
      "~/.config/opencode/skills/*": "allow",
      // --no-sandbox: the config directory ocbox assembles in the checkout.
      // OpenCode reaches skills through its symlink and checks that path as
      // given - its own skill rules use exactly this path. Anchoring on
      // .ocbox/no-sandbox keeps out any "<anywhere>/opencode-config/skills/",
      // which the earlier "*/opencode-config/skills/<name>/*" let in.
      "*/.ocbox/no-sandbox/opencode-config/skills/*": "allow",
      // Where the plan agent may keep its plans. OpenCode allows it among its
      // defaults, which the "*" above overrides.
      "~/.local/share/opencode/plans/*": "allow"
    },
    "doom_loop": "deny",

    // Secrets and credentials, as a second line behind external_directory.
    // Patterns here match the worktree-relative path, so they start with *
    // rather than ~/: "*.ssh/*" matches ".ssh/id_rsa", "../.ssh/id_rsa" and
    // "home/u/.ssh/id_rsa" alike. In the sandbox the host's own files aren't
    // mounted, so this mainly guards secrets inside the project.
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.ssh/*": "deny",
      "*.gnupg/*": "deny",
      "*.aws/*": "deny",
      "*.kube/*": "deny",
      "*.netrc": "deny",
      "*.docker/config.json": "deny"
    },

    // Credentials are never editable either. User-level config (~/.config,
    // shell rc files, ~/.gitconfig) lies outside every project, where
    // external_directory's "*": "deny" already refuses it. An entry here
    // couldn't target it anyway: edit patterns are worktree-relative, and a
    // project can hold its own .config/ or .bashrc.
    "edit": {
      "*": "allow",
      "*.ssh/*": "deny",
      "*.gnupg/*": "deny",
      // Skills are read, never rewritten: an edited skill would reach every
      // later session. The sandbox mounts skills/ read-only anyway; under
      // --no-sandbox, external_directory lets the model reach these files (see
      // above), so this is what keeps the edit and write tools off them. A
      // bash redirect still could - nothing in --no-sandbox is a guarantee.
      "*/.config/opencode/skills/*": "deny",
      "*/.ocbox/no-sandbox/opencode-config/skills/*": "deny"
    },

    "bash": {
      "*": "allow",

      // Privilege escalation and system package managers. The sandbox has no
      // sudo and no apt/dnf on PATH for the running agent (extra packages are
      // layered at image-build time, before the sandbox starts) - these
      // patterns just never match there. On the host they're the main guard.
      "sudo *": "deny",
      "su *": "deny",
      "doas *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "dnf *": "deny",
      "yum *": "deny",
      "zypper *": "deny",
      "pacman *": "deny",
      "brew *": "deny",
      "conda *": "deny",
      "mamba *": "deny",

      // Installers that write outside the workspace by design.
      "pipx *": "deny",
      "pip install --user *": "deny",
      "cargo install *": "deny",
      "go install *": "deny",
      "npm i -g *": "deny",
      "npm install -g *": "deny",
      "npm install --global *": "deny",

      // Changing the dependency set. The sandbox has no network beyond the
      // LLM relay, so these would fail regardless of this permission; on the
      // host they're a real install and need a check-in first.
      "pip install *": "ask",
      "pip uninstall *": "ask",
      "uv add *": "ask",
      "uv remove *": "ask",
      "uv pip install *": "ask",
      "npm i *": "ask",
      "npm install *": "ask",
      "npm uninstall *": "ask",
      "cargo add *": "ask",
      "cargo remove *": "ask",

      // Materializing what's ALREADY declared stays free. These come after
      // the "ask" rules on purpose: last match wins, so
      // `pip install -r requirements.txt` resolves to allow, while a bare
      // `pip install requests` stays gated. Do not move them up.
      "uv sync*": "allow",
      "uv lock --check*": "allow",
      "pip install -r *": "allow",
      "pip install --require-hashes *": "allow",
      "pip install -e .*": "allow",
      "npm ci*": "allow",
      "go mod download*": "allow",
      "go mod verify*": "allow",
      "cargo build*": "allow",
      "cargo fetch*": "allow",
      "cargo test*": "allow",

      // Downloads landing on disk. curl/wget cannot be split by pattern into
      // "read a page" vs "save a file", so both ask.
      "curl *": "ask",
      "wget *": "ask",
      "git clone *": "ask",

      // Leaving the machine or rewriting history. Plain `git commit` is
      // intentionally absent: local and recoverable. The mounted workspace is
      // real in every mode, so this matters in the sandbox too, not just
      // --no-sandbox.
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git rebase *": "ask",
      "git commit --amend*": "ask",
      "git filter-branch*": "deny",
      "npm publish*": "ask",
      "cargo publish*": "ask",
      "twine upload*": "ask",

      // Shared allocation - job schedulers, typically only reachable/present
      // on the host.
      "sbatch *": "ask",
      "srun *": "ask",
      "salloc *": "ask",
      "qsub *": "ask",
      "bsub *": "ask",

      // Capability queries are pre-approved: they report what the machine
      // offers and expose nobody's data. Without these, external_directory's
      // deny-by-default would still block nothing here (these are bash, not
      // filesystem reads), but they'd otherwise fall through to the "ask"
      // default above on every call.
      "module *": "allow",
      "pkg-config *": "allow",
      "ldconfig *": "allow",
      "nproc*": "allow",
      "lscpu*": "allow",
      "nvidia-smi*": "allow",

      // Catastrophic-deletion guards. Ordinary `rm -rf build/` stays free;
      // these only stop the targets that are never recoverable.
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf $HOME*": "deny"
    }
  },

  // Plan agent. OpenCode's built-in `plan` may edit nothing but its plan
  // file, but those rules sit among its defaults, and the global "edit"
  // block above ("*": "allow") comes after them and lifts the restriction.
  // So they're restated here, where they come last. A bare "edit": "deny"
  // re-denied everything, the plan file included. Only permissions are
  // touched, never the prompt - the reason agents/build.md and agents/plan.md
  // don't exist (see agents/README.md).
  "agent": {
    "plan": {
      "permission": {
        "edit": {
          "*": "deny",
          ".opencode/plans/*.md": "allow",
          "*/.local/share/opencode/plans/*.md": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "module avail*": "allow",
          "module spider*": "allow"
        }
      }
    }
  }
}
